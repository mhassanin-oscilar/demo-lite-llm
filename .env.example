# OpenAI key — used by the LiteLLM proxy to call upstream models
OPENAI_API_KEY=sk-replace-me

# LiteLLM proxy admin key (must start with sk-). Used for both the proxy auth
# and to query /spend/logs from main.py.
LITELLM_MASTER_KEY=sk-master-dev-change-me

# Random salt for encrypting model creds in the DB. Cannot change after
# adding models without re-encrypting. Generate with: openssl rand -hex 32
LITELLM_SALT_KEY=replace-with-random-hex

# Postgres password used by both the postgres container and the proxy
POSTGRES_PASSWORD=litellm

# Where the Python client reaches the proxy
LITELLM_BASE_URL=http://localhost:4000
